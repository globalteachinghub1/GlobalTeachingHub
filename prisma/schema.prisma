generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
}

enum StudentLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum ClassDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  GENERAL
  INVOICE_GENERATED
  PAYMENT_REMINDER
  WEEKLY_REPORT
  MONTHLY_REPORT
  ATTENDANCE_ALERT
  STUDENT_JOINED
  PAYMENT_RECEIVED
  SOP_PUBLISHED
  NEW_LEAD
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadSource {
  FREE_TRIAL
  CONTACT
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  ENROLLED
  LOST
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?

  teacher Teacher?
  student Student?
  parent  Parent?

  sopDocuments        SopDocument[]
  leadNotes           LeadNote[]
  passwordResetTokens PasswordResetToken[]
  sentMessages        Message[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/**
 * A parent/guardian account with read-only access to their linked
 * students' attendance, invoices, reports, and notifications.
 */
model Parent {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[] @relation("ParentStudents")

  messageThreads MessageThread[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  summary     String
  topics      String[]
  /// Learning outcomes shown in the "What You'll Achieve" section on the course details page.
  outcomes    String[] @default([])
  /// Short pricing blurb shown in the course details page's Pricing section (e.g. "Custom pricing based on your schedule — book a free trial to discuss.").
  priceNote   String?
  color       String   @default("text-teal-600 bg-teal-100")
  icon        String   @default("BookOpen")
  createdAt   DateTime @default(now())

  teachers     Teacher[]
  enrollments  Enrollment[]
  leads        Lead[]
  translations CourseTranslation[]
}

/**
 * Per-locale override of a course's name/summary/description/topics. The
 * base Course fields are the content for the default locale (English);
 * a visitor in another language sees the matching row here if one exists,
 * or falls back to the base fields otherwise.
 */
model CourseTranslation {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  summary     String
  description String?
  topics      String[]
  outcomes    String[] @default([])
  priceNote   String?
  updatedAt   DateTime @updatedAt

  @@unique([courseId, locale])
}

model Teacher {
  id      String   @id @default(cuid())
  userId  String   @unique
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  students Student[]
}

model Student {
  id            String        @id @default(cuid())
  userId        String?       @unique
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String        @unique
  phone         String?
  whatsapp      String?
  parentName    String?
  parentContact String?
  teacherId     String?
  teacher       Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  level         StudentLevel  @default(BEGINNER)
  progress      Int           @default(0)
  status        StudentStatus @default(ACTIVE)
  joined        DateTime      @default(now())
  monthlyFee    String?

  enrollments   Enrollment[]
  notes         ProgressNote[]
  invoices      Invoice[]
  notifications Notification[]
  documents     Document[]
  parents       Parent[]       @relation("ParentStudents")

  messageThreads MessageThread[]
}

/**
 * A conversation between one parent and their child's teaching team (that
 * student's teacher, plus any admin/staff) — one thread per (student, parent)
 * pair, not per staff member, so any authorized staff member can view and
 * reply.
 */
model MessageThread {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([studentId, parentId])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
}

/**
 * A student's enrollment in one course — carries that course's own class schedule, attendance, and reports.
 */
model Enrollment {
  id             String     @id @default(cuid())
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classStartTime String?
  classEndTime   String?
  classDays      ClassDay[]
  createdAt      DateTime   @default(now())

  attendance     Attendance[]
  weeklyReports  WeeklyReport[]
  monthlyReports MonthlyReport[]
  assignments    Assignment[]

  @@unique([studentId, courseId])
}

model Assignment {
  id           String    @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProgressNote {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note      String
  date      DateTime @default(now())

  translations ProgressNoteTranslation[]
}

/**
 * Cached machine translation of a progress note's text into one locale —
 * translated once via DeepL on first read in that locale, then reused,
 * since the original note text never changes after it's written.
 */
model ProgressNoteTranslation {
  id        String       @id @default(cuid())
  noteId    String
  note      ProgressNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  locale    String
  text      String
  createdAt DateTime     @default(now())

  @@unique([noteId, locale])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  description   String
  amount        String
  amountPaid    String?
  dueDate       DateTime?
  date          DateTime      @default(now())
  status        InvoiceStatus @default(PENDING)
}

model Attendance {
  id              String     @id @default(cuid())
  enrollmentId    String
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date            DateTime   @db.Date
  present         Boolean
  lessonRemarks   String?
  homeworkRemarks String?
  teacherComment  String?
  createdAt       DateTime   @default(now())

  @@unique([enrollmentId, date])
}

model WeeklyReport {
  id             String     @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  weekStart      DateTime   @db.Date
  weekEnd        DateTime   @db.Date
  presentCount   Int
  totalCount     Int
  topicsCovered  String
  teacherRemarks String?
  sentEmail      Boolean    @default(false)
  sentWhatsapp   Boolean    @default(false)
  createdAt      DateTime   @default(now())
}

model MonthlyReport {
  id                 String     @id @default(cuid())
  enrollmentId       String
  enrollment         Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  month              Int
  year               Int
  attendancePercent  Float
  performanceSummary String
  teacherRemarks     String?
  sentEmail          Boolean    @default(false)
  sentWhatsapp       Boolean    @default(false)
  createdAt          DateTime   @default(now())

  @@unique([enrollmentId, month, year])
}

model Document {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  docType   String
  status    DocumentStatus @default(PENDING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  message   String
  /// Structured data for templated types (INVOICE_GENERATED, PAYMENT_REMINDER,
  /// WEEKLY_REPORT, MONTHLY_REPORT) so the sentence can be rendered in the
  /// viewer's own locale at read time. `message` stays as the English
  /// fallback for older rows and any type without a template.
  params    Json?
  date      DateTime         @default(now())

  translations NotificationTranslation[]
}

/**
 * Cached machine translation of a notification's stored `message` — used
 * as the fallback when the notification's type/params don't match a known
 * template (older rows created before templating existed, and the free-form
 * GENERAL type). Translated once via DeepL on first read in that locale,
 * then reused, since a notification's message never changes after creation.
 */
model NotificationTranslation {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  locale         String
  text           String
  createdAt      DateTime     @default(now())

  @@unique([notificationId, locale])
}

/**
 * Company-wide SOP library, organized into categories. Shared by Admin,
 * Teacher, and Staff — not tied to a single student.
 */
model SopCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  documents SopDocument[]
}

model SopDocument {
  id          String         @id @default(cuid())
  categoryId  String
  category    SopCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  version     Int            @default(1)
  status      DocumentStatus @default(PENDING)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/**
 * Broadcast notifications for Admin/Teacher/Staff (student joined, payment
 * received, SOP published, ...). `readBy` tracks which users have dismissed
 * it — there's one org-wide feed rather than a per-recipient row.
 */
model SystemNotification {
  id        String           @id @default(cuid())
  type      NotificationType @default(GENERAL)
  message   String
  link      String?
  readBy    String[]         @default([])
  createdAt DateTime         @default(now())
}

/**
 * A prospective student captured from the Free Trial or Contact forms,
 * tracked through a simple CRM pipeline until enrolled or lost.
 */
model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  courseId  String?
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  message   String?
  source    LeadSource
  stage     LeadStage  @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  notes LeadNote[]
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
